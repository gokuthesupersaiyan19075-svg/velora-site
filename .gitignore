# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# media: originals are multi-GB and re-downloadable (scripts/assets/download.mjs); renditions are generated (renditions.mjs)
/media/originals/
/public/media/web/
/public/media/photos/
*.part.*
media-*.log
/media/intake/
/public/media/graded/

# Frame sequences are deployed with the site but not committed to GitHub
/public/media/seq/

# generated by scripts/export.mjs
/public/media/sized
/out

# Supabase CLI local state and build logs
/supabase/.temp
/export.log
!.env.example

# Third-party media is not redistributed in this repository (see README, "Media")
/public/media/audio/
/public/media/clips/

# Personal Claude/agent configuration is not published
/.claude/
